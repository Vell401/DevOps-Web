# Copy to .env and adjust. These are injected into the k6 container (env_file in
# docker-compose.yml) and read by the scripts via __ENV.

# --- Target (the VM's edge, plain HTTP on port 80) ---
# Use the LAN IP of the runner VM. WS_URL defaults to BASE_URL with ws:// scheme,
# so you normally only set BASE_URL.
BASE_URL=http://192.168.1.50
# WS_URL=ws://192.168.1.50

# --- Identity space ---
# Users are <EMAIL_PREFIX>+<n>@<EMAIL_DOMAIN> for n in [0, USERS).
# LOAD_PASSWORD is shared by all of them (must be >= 8 chars per the API).
LOAD_PASSWORD=Loadtest12345
USERS=300
EMAIL_PREFIX=loadtest
EMAIL_DOMAIN=example.com

# --- Seed phase volume (per user) ---
PROJECTS_PER_USER=5
TASKS_PER_PROJECT=20
# Parallelism of the seed phase. Keep low (<=5) if the auth throttle is NOT
# relaxed on the VM, or registrations will hit 429 (10/min/IP by default).
SEED_VUS=20

# --- Load phase shape ---
VUS=300
DURATION=5m
RAMP=1m
# How long each Socket.IO connection is held open before closing.
SOCKET_HOLD=60s

# --- Human think-time between actions (seconds) ---
THINK_MIN=1
THINK_MAX=4
